{
  "name": "mutalog",
  "version": "0.3.2",
  "private": true,
  "description": "Development tooling and release versioning for the Mutalog repository. Not part of the SWI-Prolog pack; its version is copied to pack.pl when changesets are consumed.",
  "license": "BSD-2-Clause",
  "scripts": {
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/sync-version.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "kibi-cli": "^2.40.0",
    "kibi-core": "^0.29.0",
    "kibi-lang-bash": "^1.0.0",
    "kibi-lang-prolog": "^1.0.0",
    "kibi-mcp": "^3.24.0",
    "kibi-plugin-treesitter": "^3.0.0"
  },
  "kibi": {
    "plugins": [
      {
        "package": "kibi-plugin-treesitter",
        "capabilities": {
          "kibi.symbol-extractor.v2": {
            "mode": "augment"
          }
        }
      }
    ]
  }
}
